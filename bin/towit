#!/usr/bin/env bash
# To Wit — Claude Code conversation catalog
#
# Usage:
#   towit <subcommand> [options]
#
# Subcommands:
#   setup [--full | --hook | --config]
#                                 Initialize database
#                                   --full    also generates config, installs hooks, and runs backfill
#                                   --hook    also installs the Claude Code hooks
#                                   --config  generate ~/.towit/config.toml (skips if already exists)
#   search <terms...> [--or] [--topic] [--all | --summary | --title] [--only text|metadata]
#                 [--format json|csv] [--folder <path>] [--repo <path|name>]
#                                 --repo NAME also matches worktree directories named NAME.<branch>
#                                 The Msg column is the message number to pass to `towit show --around`
#                                 Default: message text plus keywords, titles, summaries;
#                                   --only metadata restores the keywords-only scope
#                                 If all terms find nothing, retries matching any term
#                                   (not with --or or --only metadata); notice on stderr
#   list [--format json|csv] [--folder <path>] [--topic <name>] [--keyword <name>]
#   resume <session-id> [--force] Resume a session in its original working directory
#   show <session-id> [--around <msg>] [--context <n>] [--format text|json]
#                                 Print archived messages (message numbers are 0-based);
#                                   --around takes the Msg column from `search` results and shows
#                                   <n> messages either side of <msg> (default 5);
#                                   --context only applies with --around
#   prune [--archive] [--yes] [--dry-run]
#                                 Remove entries whose transcripts no longer exist; archived
#                                   conversations are kept unless --archive is given
#                                   (--yes skips its confirmation)
#   forget <session-id> | --repo <path|name> | --folder <path> [--yes]
#                                 Permanently delete conversations (messages, search index,
#                                   topics, keywords) and block re-ingestion; exactly one
#                                   selector is required; --folder matches the working
#                                   directory exactly; --repo NAME also matches NAME.<branch>
#                                   directories and the matched repo keys are listed first;
#                                   prompts unless --yes
#   export <session-id> [--format md|json] [--summarize]
#   export --topic <name> [--format md|json] [--summarize]
#   backfill [--dry-run] [--force] [--folder <path>]
#                                 Archive and index existing transcripts
#   install-hook                  Add the To Wit hooks (Stop, SessionEnd, SessionStart)
#                                   to ~/.claude/settings.json
#   uninstall-hook                Remove the To Wit hooks from ~/.claude/settings.json
#   teardown [--yes]              Remove hooks and delete database (including the archive)
#   implode [--yes] [--install-dir <dir>]
#                                 Full uninstall: remove hooks, database (including the
#                                   archive), and binary symlink
#   stats                         Show catalog statistics
#   doctor                        Verify setup: config, database (FTS5, archive schema), and hooks
#   version | --version | -v      Print the installed version
#   help                          Show this message

set -euo pipefail

# Resolve real script location, following symlinks (macOS readlink lacks -f)
_source="$0"
while [ -L "${_source}" ]; do
  _dir="$(cd -P "$(dirname "${_source}")" && pwd)"
  _source="$(readlink "${_source}")"
  [[ "${_source}" != /* ]] && _source="${_dir}/${_source}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${_source}")" && pwd)"
unset _source _dir
HELPERS_DIR="$(cd "${SCRIPT_DIR}/../libexec/towit" && pwd)"

PYTHON="${TOWIT_PYTHON:-python3}"

if ! command -v "${PYTHON}" &>/dev/null; then
  if [ -n "${TOWIT_PYTHON:-}" ]; then
    echo "Error: TOWIT_PYTHON is set to '${TOWIT_PYTHON}' but that interpreter was not found." >&2
    echo "Unset TOWIT_PYTHON or point it at a working Python 3." >&2
  else
    echo "Error: python3 is required but was not found in PATH." >&2
    echo "Install Python 3 and ensure it is available as 'python3'." >&2
  fi
  exit 1
fi

usage() {
  awk '/^[^#]/ { exit } /^#!/ { next } { sub(/^# ?/, ""); print }' "$0"
}

subcommand="${1:-}"

case "${subcommand}" in
  setup)
    shift
    _full=false
    _hook=false
    _setup_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        # --full is consumed here, so forward --config for towit_setup.py to generate the config
        --full) _full=true; _setup_args+=(--config); shift ;;
        --hook) _hook=true; shift ;;
        *) _setup_args+=("$1"); shift ;;
      esac
    done
    "${PYTHON}" "${HELPERS_DIR}/towit_setup.py" "${_setup_args[@]+"${_setup_args[@]}"}" || exit $?
    if [[ "${_full}" == true || "${_hook}" == true ]]; then
      "${PYTHON}" "${HELPERS_DIR}/towit_install_hook.py" || exit $?
    fi
    if [[ "${_full}" == true ]]; then
      "${PYTHON}" "${HELPERS_DIR}/towit_backfill.py" || exit $?
    fi
    ;;
  search)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_search.py" "$@" || exit $?
    ;;
  list)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_list.py" "$@" || exit $?
    ;;
  resume)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_resume.py" "$@" || exit $?
    ;;
  open)
    shift
    echo "Warning: 'open' is deprecated; use 'resume' instead." >&2
    "${PYTHON}" "${HELPERS_DIR}/towit_resume.py" "$@" || exit $?
    ;;
  show)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_show.py" "$@" || exit $?
    ;;
  prune)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_prune.py" "$@" || exit $?
    ;;
  forget)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_forget.py" "$@" || exit $?
    ;;
  export)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_export.py" "$@" || exit $?
    ;;
  backfill)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_backfill.py" "$@" || exit $?
    ;;
  install-hook)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_install_hook.py" "$@" || exit $?
    ;;
  uninstall-hook)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_uninstall_hook.py" "$@" || exit $?
    ;;
  teardown)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_teardown.py" "$@" || exit $?
    ;;
  implode)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_implode.py" "$@" || exit $?
    ;;
  stats)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_stats.py" "$@" || exit $?
    ;;
  doctor)
    shift
    "${PYTHON}" "${HELPERS_DIR}/towit_doctor.py" "$@" || exit $?
    ;;
  version|--version|-v)
    # Never fails: a missing, empty or unreadable VERSION file reports "unknown".
    _version="$(cat "${HELPERS_DIR}/VERSION" 2>/dev/null || true)"
    _version="${_version//[[:space:]]/}"
    echo "towit ${_version:-unknown}"
    ;;
  help|--help|-h)
    usage
    ;;
  "")
    echo "Error: no subcommand given." >&2
    echo >&2
    usage >&2
    exit 1
    ;;
  *)
    echo "Error: unknown subcommand '${subcommand}'." >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
